<footer role="contentinfo">
  <p class="foot-name">{{ site.first_name }} {{ site.last_name }}</p>
  <p>Nokia Bell Labs &amp; University of Cambridge</p>
  <p>
    <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a> &middot;
    <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a> &middot;
    <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a> &middot;
    <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a>
  </p>
  <p>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</p>
</footer>
