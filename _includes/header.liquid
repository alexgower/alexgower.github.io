<div class="navwrap {% if page.hero %}navwrap-overlap{% endif %}">
  <nav id="navbar" aria-label="Main">
    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      Menu <span aria-hidden="true">&#9776;</span>
    </button>
    <ul id="nav-menu">
      <li>
        <a href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}aria-current="page"{% endif %}>Home</a>
      </li>
      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav and p.autogen == null %}
          {% assign parent_link = p.permalink | remove: 'index.html' %}
          {% assign show_page = true %}
          {% if p.permalink contains '/blog/' %}
            {% assign url = '/blog/' %}
            {% comment %} Hide the blog from the nav until there are at least 2 posts {% endcomment %}
            {% if site.posts.size < 2 %}
              {% assign show_page = false %}
            {% endif %}
          {% else %}
            {% assign url = p.url %}
          {% endif %}
          {% if show_page %}
            <li>
              <a href="{{ url | relative_url }}" {% if page.url contains parent_link %}aria-current="page"{% endif %}>
                {{- p.title -}}
              </a>
            </li>
          {% endif %}
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
</div>
